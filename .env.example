# Optional model-provider configuration. The local deterministic provider is the
# development default and is intentionally credential-free.
EIW_MODEL_PROVIDER=deterministic
OPENAI_API_KEY=

# PostgreSQL is the production-shaped metadata store. Tests may override this.
EIW_DATABASE_URL=postgresql+psycopg://eiw:eiw@localhost:5432/eiw
EIW_ARTIFACT_ROOT=./artifacts


# Retail BA Agent. Leave empty to use the deterministic built-in demo dataset.
EIW_RETAIL_DATA_DIR=

# Optional full DeepAnalyze API server (not bare vLLM) for open-ended code analysis.
EIW_DEEPANALYZE_URL=

# Optional model-driven Supervisor. The deterministic planner remains the
# benchmarked default and automatic fallback.
EIW_RETAIL_SUPERVISOR_URL=
EIW_RETAIL_SUPERVISOR_MODEL=qwen3
EIW_RETAIL_SUPERVISOR_API_KEY=

# First-party AI Coding worker. Generated code runs in a Docker sandbox with
# network disabled, read-only root filesystem, memory/CPU/PID limits.
EIW_RETAIL_CODE_MODEL_URL=
EIW_RETAIL_CODE_MODEL=qwen3
EIW_RETAIL_CODE_MODEL_API_KEY=
